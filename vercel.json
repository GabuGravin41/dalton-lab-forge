{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/main.js?path=$1"
    },
    {
      "source": "/u/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/forge",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
