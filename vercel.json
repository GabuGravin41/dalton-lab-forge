{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/main.js"
    },
    {
      "source": "/u/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/forge",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
